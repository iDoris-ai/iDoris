{
  "name": "idoris",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "check:contract-drift": "node scripts/check-contract-drift.mjs",
    "test:golden": "pnpm --filter @idoris/adapters test:golden",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "test:privacy": "pnpm --filter @idoris/router test tests/privacy.test.ts",
    "test:audit": "pnpm --filter @idoris/router test tests/audit.test.ts",
    "test:tenancy": "pnpm --filter @idoris/tenancy test",
    "test:billing": "pnpm --filter @idoris/tenancy test tests/billing.test.ts",
    "test:egress": "pnpm --filter @idoris/router test:egress",
    "smoke:agent24": "pnpm build && node scripts/smoke-agent24.mjs",
    "smoke:external": "pnpm --filter @idoris/adapters build && node scripts/smoke-external.mjs",
    "test:growth": "pnpm --filter @idoris/growth test",
    "test:federation": "pnpm --filter @idoris/federation test"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "globals": "^17.12.0",
    "json-schema-to-zod": "^2.8.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
