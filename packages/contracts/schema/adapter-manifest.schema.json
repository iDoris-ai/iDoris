{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idoris.ai/schema/adapter-manifest.schema.json",
  "title": "AdapterManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "base_model_id",
    "base_digest",
    "tokenizer_digest",
    "rank",
    "data_class"
  ],
  "properties": {
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "base_model_id": {
      "type": "string",
      "minLength": 1
    },
    "base_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "tokenizer_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "data_class": {
      "enum": [
        "synthetic",
        "anonymized",
        "real"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "target_modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
