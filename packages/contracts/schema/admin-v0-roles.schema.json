{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idoris.ai/schema/admin-v0-roles.schema.json",
  "title": "AdminV0RolesResponse",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["role", "aliases", "catalog_role"],
    "properties": {
      "role": { "type": "string", "minLength": 1 },
      "aliases": {
        "type": "array",
