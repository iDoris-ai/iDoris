{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idoris.ai/schema/task-profile.schema.json",
  "title": "TaskProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "privacy": {
      "enum": [
        "local_only",
        "any"
      ],
      "default": "local_only"
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "default": "chat"
    },
    "complexity": {
      "enum": [
        "simple",
        "complex"
      ],
      "default": "simple"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "chat",
          "reasoning",
          "vision",
          "asr",
          "tts",
          "coding",
          "embedding",
          "rerank"
        ]
      },
      "default": [
        "chat"
      ]
    },
    "fallback": {
      "enum": [
        "fail_closed",
        "next_in_chain"
      ]
    }
  }
}
